#pragma once
//
// Copy this file to secrets.h and fill in your own values:
//
//     cp secrets.h.example secrets.h
//
// secrets.h is gitignored. Never commit real credentials — this sketch lives
// in a public repo, and a WiFi password in git history stays there.

#define WIFI_SSID "your-ssid"
#define WIFI_PASS "your-password"

// mDNS name of the machine running server.py (no ".local" suffix).
// This is the primary lookup — it keeps working when the LAN renumbers,
// so a new subnet no longer means a reflash. On macOS the name comes from
//     scutil --get LocalHostName
#define SERVER_HOST "my-mac"

// Fallback, used only when mDNS gets no answer — some APs (especially guest
// and IoT SSIDs) filter multicast, which is what mDNS rides on.
#define SERVER_IP_OCTETS 192, 168, 1, 100

#define SERVER_PORT 8266
